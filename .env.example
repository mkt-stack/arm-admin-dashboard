# Login accounts for the admin UI, as a JSON object of {"username":"password"}
# — one entry per person, plaintext (same trust boundary as the two secrets
# below: only visible to whoever can see this service's Railway variables).
# Per the 2026-09-17 decision (extended to multi-user 2026-09-18): still a
# fixed roster set via env var, not self-service accounts, not Cloudflare
# Access. Must be valid JSON with at least one entry.
ADMIN_UI_USERS={"admin":"change-me-to-something-long-and-random","jane":"another-long-random-password"}

# Signs the session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-too

# arm-worker-v2's deployed URL (no trailing slash) and its ADMIN_TOKEN secret.
# This server holds the token — the browser never sees it.
ARM_WORKER_BASE_URL=https://arm-worker-v2.tantus-c.workers.dev
ARM_ADMIN_TOKEN=same-value-as-arm-worker-v2s-ADMIN_TOKEN-secret

NODE_ENV=production
PORT=3000

# Optional. Not a secret — just the store handle used to build "open in
# Shopify admin" links on the Profiles tab (https://<domain>/admin/customers/<id>).
# Leave unset to hide that button.
SHOPIFY_STORE_DOMAIN=gqsizekol.myshopify.com
